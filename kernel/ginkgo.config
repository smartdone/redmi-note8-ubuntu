# Config fragment merged on top of arm64 defconfig.
# Everything needed to reach the root filesystem and USB networking is
# built in (=y), so the initramfs does not need to load modules.

CONFIG_LOCALVERSION="-ginkgo"
CONFIG_LOCALVERSION_AUTO=n

# SoC core: clocks, pinctrl, RPM, power domains, regulators
CONFIG_ARCH_QCOM=y
CONFIG_SM_GCC_6125=y
CONFIG_SM_DISPCC_6125=y
CONFIG_SM_GPUCC_6125=m
CONFIG_PINCTRL_SM6125=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_RPM_MASTER_STATS=y
CONFIG_QCOM_SCM=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_BLOCK_MINORS=64
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_CRYPTO_ZSTD=y

# Display: keep the framebuffer the bootloader set up
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_TER16x32=y
CONFIG_FONTS=y
# Real display: MSM DPU + DSI + Huaxing FT8719 panel (kernel/patches/0012, 0013).
# simpledrm keeps the bootloader framebuffer until msm takes over.
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_HUAXING_FT8719=y

# Backlight: LM3697 (bank B) exposed as /sys/class/backlight via led-backlight
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_LM3697=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_LED=y

# Touchscreen: FocalTech FT8719 in-cell over SPI (QUP SE2)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_TOUCHSCREEN_FT8719_SPI=y

# USB device mode + USB networking gadget
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_U_ETHER=y

# Buttons, vibrator, reboot modes (reboot bootloader/recovery via PMIC PON)
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8XXX_VIBRATOR=m

# Userspace requirements (systemd)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FHANDLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# Debug helpers for bring-up
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Wi-Fi bring-up: ath10k debug messages (debug_mask module parameter)
CONFIG_ATH10K_DEBUG=y

# Battery: read-only PMI632 monitor (kernel/patches/0017)
CONFIG_BATTERY_QCOM_PMI632=m

# Audio: ADSP (q6 APR) + MAX98937 speaker amp on primary MI2S (sm8250 card)
CONFIG_SND_SOC_MAX98937=m
