+		if (ret)
+			dev_err(dev, "Cannot write full-scale current\n");
+	}
+
+	/* Both banks share the mapping; exponential is the chip default. */
+	if (priv->linear_map) {
+		ret = regmap_update_bits(priv->regmap, LM3697_CTRL_A_B_BRT_CFG,
+					 LM3697_MAP_LINEAR, LM3697_MAP_LINEAR);
+		if (ret)
+			dev_err(dev, "Cannot set linear mapping\n");
+	}
+
+	if (priv->boost_cfg >= 0) {
+		ret = regmap_write(priv->regmap, LM3697_BOOST_CTRL, priv->boost_cfg);
+		if (ret)
+			dev_err(dev, "Cannot write boost control\n");
+	}
