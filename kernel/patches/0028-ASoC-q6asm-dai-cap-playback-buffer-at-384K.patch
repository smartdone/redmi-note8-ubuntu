+	.buffer_bytes_max =     PLAYBACK_MAX_BUFFER_BYTES,
 	.period_bytes_min =	PLAYBACK_MIN_PERIOD_SIZE,
 	.period_bytes_max =     PLAYBACK_MAX_PERIOD_SIZE,
 	.periods_min =          PLAYBACK_MIN_NUM_PERIODS,
@@ -416,7 +422,7 @@
